META_WHATSAPP_LANGUAGE_CODE=en
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-verification-token
META_APP_SECRET=replace-with-your-meta-app-secret
META_WHATSAPP_TEMPLATE_MEMBERSHIP_EXPIRING=membership_expiring
