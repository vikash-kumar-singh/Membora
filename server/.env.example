# Configure these in the server host's secret/environment settings. Never commit a real private key.
# IMAGEKIT_* is optional and is needed only to open legacy private ImageKit files.
IMAGEKIT_PRIVATE_KEY=replace-with-a-rotated-imagekit-private-key
IMAGEKIT_PUBLIC_KEY=public_cNDr0TfiDtmw5Dgx+VVpRBo7+C4=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/membora
FIREBASE_PROJECT_ID=membora-app
JWT_SECRET=replace-with-at-least-32-random-bytes
DB_URL=jdbc:mysql://localhost:3306/membora
DB_USERNAME=membora
DB_PASSWORD=replace-with-a-database-password
META_WHATSAPP_ACCESS_TOKEN=replace-with-a-permanent-system-user-token
